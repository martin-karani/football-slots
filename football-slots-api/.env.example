# Database
DATABASE_URL=postgres://postgres:password@localhost:5432/football_slots

# JWT
JWT_SECRET=change-me-in-production-min-32-characters-long

# Server
PORT=3000
HOST=0.0.0.0
RUST_LOG=info

# Virtual currency defaults
VIRTUAL_INITIAL_BALANCE=100000
BONUS_INITIAL_BALANCE=50000

# Real money wagering limits (minor units = cents)
REAL_MIN_STAKE=50
REAL_MAX_STAKE=500000
VIRTUAL_MIN_STAKE=1
VIRTUAL_MAX_STAKE=1000000

# M-Pesa Daraja API (sandbox)
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_PASSKEY=bfb97d979cec43b8a42f784641639b2c0673e15d827d32a92d3d96a3f3e10d5b
MPESA_SHORTCODE=174379
MPESA_LIPA_URL=https://sandbox.safaricom.co.ke/mpesa/stkpush/v1/processrequest
MPESA_BASE_URL=https://sandbox.safaricom.co.ke

# OTP Service (Africa's Talking / Twilio)
OTP_API_KEY=
OTP_FROM_NUMBER=
OTP_BASE_URL=

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:8081

# App base URL (used to build M-Pesa callback/result URLs). Point this at
# your ngrok/cloudflared tunnel in dev, your real domain in prod.
APP_BASE_URL=http://localhost:3000

# M-Pesa B2C (withdrawals) - sandbox. Register your use case (this will be
# reviewed as a gambling-payout use case, e.g. "BusinessPayment") on the
# Daraja portal before switching these to production values.
MPESA_INITIATOR_NAME=testapi
MPESA_SECURITY_CREDENTIAL=
MPESA_B2C_SHORTCODE=600000
MPESA_B2C_URL=https://sandbox.safaricom.co.ke/mpesa/b2c/v1/paymentrequest

# Withdrawal limits (minor units = cents) -- tune to your own policy
REAL_MIN_WITHDRAWAL=10000
REAL_MAX_WITHDRAWAL=7000000
DAILY_WITHDRAWAL_LIMIT_MINOR=15000000

# Bonus Meter
BONUS_METER_ENABLED=true
BONUS_METER_SHADOW=false
BONUS_METER_TARGET=50
BONUS_METER_REWARD_MINOR=1000
BONUS_METER_WAGER_MULTIPLIER=5
BONUS_MIN_STAKE=50
BONUS_MAX_STAKE=500
BONUS_GRANT_EXPIRY_HOURS=168
BONUS_MAX_DAILY_GRANTS_PER_USER=1

# Security: M-Pesa callback IP whitelist (comma-separated CIDR ranges).
# Empty = allow all (dev mode only). Production MUST restrict to Safaricom IPs.
# Safaricom production callback IPs (verify with Safaricom before deploying):
MPESA_CALLBACK_ALLOWED_IPS=111.235.100.0/24,41.59.2.0/24,196.200.224.0/19

# Security: Rate limit for M-Pesa STK push deposits (seconds between requests per user).
# Prevents rapid-fire STK pushes that cost the business per request.
DEPOSIT_RATE_LIMIT_SECONDS=30

# Daily deposit limit (minor units = cents). Overrides the per-user DB column if NULL.
# Default: KES 500,000
DAILY_DEPOSIT_LIMIT_MINOR=50000000
