# Database
DATABASE_URL=postgres://postgres:password@localhost:5432/football_slots

# JWT
JWT_SECRET=change-me-in-production-min-32-characters-long

# Server
PORT=3000
HOST=0.0.0.0
RUST_LOG=info

# Virtual currency defaults
VIRTUAL_INITIAL_BALANCE=100000

# Real money wagering limits (minor units = cents)
REAL_MIN_STAKE=50
REAL_MAX_STAKE=500000
VIRTUAL_MIN_STAKE=1
VIRTUAL_MAX_STAKE=1000000

# M-Pesa Daraja API (sandbox)
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_PASSKEY=bfb97d979cec43b8a42f784641639b2c0673e15d827d32a92d3d96a3f3e10d5b
MPESA_SHORTCODE=174379
MPESA_LIPA_URL=https://sandbox.safaricom.co.ke/mpesa/stkpush/v1/processrequest
MPESA_BASE_URL=https://sandbox.safaricom.co.ke

# OTP Service (Africa's Talking / Twilio)
OTP_API_KEY=
OTP_FROM_NUMBER=
OTP_BASE_URL=

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:8081

# App base URL (used to build M-Pesa callback/result URLs). Point this at
# your ngrok/cloudflared tunnel in dev, your real domain in prod.
APP_BASE_URL=http://localhost:3000

# M-Pesa B2C (withdrawals) — v3 endpoint. Register your use case on the
# Daraja portal before switching to production values.
MPESA_INITIATOR_NAME=testapi
MPESA_SECURITY_CREDENTIAL=
MPESA_B2C_SHORTCODE=600000
MPESA_B2C_URL=https://sandbox.safaricom.co.ke/mpesa/b2c/v3/paymentrequest

# M-Pesa C2B (manual Paybill deposits) — Register URL API
MPESA_C2B_REGISTER_URL=https://sandbox.safaricom.co.ke/mpesa/c2b/v2/registerurl

# M-Pesa Pull Transactions (reconciliation for missed callbacks)
MPESA_PULL_REGISTER_URL=https://sandbox.safaricom.co.ke/pulltransactions/v1/register
MPESA_PULL_QUERY_URL=https://sandbox.safaricom.co.ke/pulltransactions/v1/query

# M-Pesa B2B (Business Pay Bill) — pay from business account to another Pay Bill
MPESA_B2B_URL=https://sandbox.safaricom.co.ke/mpesa/b2b/v1/paymentrequest

# Nominated number for Pull Transactions registration.
# This is the Safaricom MSISDN associated with the shortcode (found on M-Pesa portal under Shortcode KYC).
MPESA_NOMINATED_NUMBER=254722000000

# M-Pesa Account Balance API (float monitoring)
MPESA_ACCOUNT_BALANCE_URL=https://sandbox.safaricom.co.ke/mpesa/accountbalance/v1/query

# Withdrawal limits (minor units = cents) -- tune to your own policy
REAL_MIN_WITHDRAWAL=10000
REAL_MAX_WITHDRAWAL=7000000
DAILY_WITHDRAWAL_LIMIT_MINOR=15000000

# Security: M-Pesa callback IP whitelist (comma-separated exact IPs).
# Empty = allow all (dev mode only). Production MUST restrict to Safaricom IPs.
# These are the exact Safaricom API Gateway IPs from the Daraja docs.
MPESA_CALLBACK_ALLOWED_IPS=196.201.214.200,196.201.214.206,196.201.213.114,196.201.214.207,196.201.214.208,196.201.213.44,196.201.212.127,196.201.212.138,196.201.212.129,196.201.212.136,196.201.212.74,196.201.212.69

# Security: Rate limit for M-Pesa STK push deposits (seconds between requests per user).
DEPOSIT_RATE_LIMIT_SECONDS=30

# Daily deposit limit (minor units = cents). Default: KES 500,000
DAILY_DEPOSIT_LIMIT_MINOR=50000000
